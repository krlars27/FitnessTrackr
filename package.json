{
  "name": "fitnesstrackr",
  "version": "1.0.0",
  "description": "A Node.js and Express REST API for workout management, featuring PostgreSQL data modeling, JWT authentication, and routine and activity management.",
  "main": "server.js",
  "scripts": {
    "seed:dev": "nodemon ./db/seed.js",
    "seed": "node ./db/seed.js",
    "start:dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watchAll"
  },
  "repository": { "type": "git", "url": "git+https://github.com/krlars27/FitnessTrackr.git" },
  "keywords": ["nodejs", "express", "postgresql", "javascript", "rest-api", "jwt", "backend", "database"],
  "author": "Preston Wallace",
  "license": "MIT",
  "bugs": { "url": "https://github.com/krlars27/FitnessTrackr/issues" },
  "homepage": "https://github.com/krlars27/FitnessTrackr#readme",
  "devDependencies": {
    "eslint": "^8.2.0",
    "eslint-plugin-jest": "^25.2.4",
    "nodemon": "^2.0.4",
    "supertest": "^6.1.6"
  },
  "dependencies": {
    "axios": "^0.19.2",
    "bcrypt": "^4.0.1",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "faker": "^4.1.0",
    "jest": "^26.0.1",
    "jsonwebtoken": "^8.5.1",
    "morgan": "^1.10.0",
    "pg": "^8.2.1",
    "react-router-dom": "^6.4.3"
  }
